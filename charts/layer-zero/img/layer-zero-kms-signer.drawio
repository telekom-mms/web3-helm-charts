<mxfile host="app.diagrams.net" version="24.7.17" type="device">
  <diagram id="layer-zero-kms-signer" name="KMS signer">
    <mxGraphModel dx="1400" dy="1040" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="layer-zero chart | KMS signer" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="400" y="10" width="600" height="38" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="With signer.type=KMS, Gasolina holds no key. The signing key stays in the cloud KMS." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="350" y="46" width="700" height="24" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7B1FA2&quot;&gt;━━▶&lt;/font&gt;&amp;nbsp; Signature request and answer&lt;br&gt;&lt;font color=&quot;#EF6C00&quot;&gt;━━▶&lt;/font&gt;&amp;nbsp; Blockchain data&lt;br&gt;&lt;font color=&quot;#E53935&quot;&gt;━━▶&lt;/font&gt;&amp;nbsp; AWS API call&lt;br&gt;&lt;font color=&quot;#159447&quot;&gt;┄┄▶&lt;/font&gt;&amp;nbsp; Credentials&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;┄┄▶&lt;/font&gt;&amp;nbsp; Volume mount&lt;br&gt;dashed box = optional" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=1;dashed=1;strokeColor=#666666;fillColor=#FFFFFF;fontColor=#111111;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="240" height="140" as="geometry"/></mxCell>

        <mxCell id="rpc" value="&lt;b&gt;RPC providers&lt;/b&gt;&lt;br&gt;providers.json, several per chain" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=2;strokeColor=#EF6C00;fillColor=#FFF3E0;fontColor=#111111;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="90" width="250" height="60" as="geometry"/></mxCell>

        <mxCell id="lz" value="LayerZero" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=2;dashed=1;dashPattern=6 4;strokeColor=#7B1FA2;fillColor=#FAF5FC;fontColor=#4A148C;fontStyle=1;fontSize=15;align=left;verticalAlign=top;spacingTop=6;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="230" height="590" as="geometry"/></mxCell>
        <mxCell id="essence" value="&lt;b&gt;Signing request&lt;/b&gt;&lt;br&gt;LayerZero asks the DVN to sign a cross-chain message" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;strokeColor=#7B1FA2;fillColor=#F3E5F5;fontColor=#111111;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="dvn" value="&lt;b&gt;DVN contract&lt;/b&gt;&lt;br&gt;on the destination chain, accepts the registered signer address" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;strokeColor=#7B1FA2;fillColor=#F3E5F5;fontColor=#111111;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="190" height="100" as="geometry"/></mxCell>

        <mxCell id="cluster" value="Kubernetes cluster" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;strokeWidth=2;strokeColor=#6C8EBF;fillColor=#DAE8FC;fontColor=#1F3A68;fontStyle=1;fontSize=15;align=left;verticalAlign=top;spacingTop=6;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="280" y="180" width="760" height="590" as="geometry"/></mxCell>
        <mxCell id="svc" value="&lt;b&gt;Service&lt;/b&gt;&lt;br&gt;service.*&lt;br&gt;ingress.*" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;strokeColor=#7B1FA2;fillColor=#F3E5F5;fontColor=#111111;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="320" width="120" height="110" as="geometry"/></mxCell>
        <mxCell id="pod" value="Pod" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;strokeWidth=2;strokeColor=#DAA520;fillColor=#FFFDF0;fontColor=#8A6D00;fontStyle=1;fontSize=13;align=left;verticalAlign=top;spacingTop=6;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="450" y="230" width="570" height="300" as="geometry"/></mxCell>
        <mxCell id="gas" value="&lt;b&gt;Gasolina container&lt;/b&gt;&lt;br&gt;checks each message,&lt;br&gt;then asks KMS to sign it&lt;br&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size: 11px;&quot;&gt;SIGNER_TYPE=KMS&lt;br&gt;KMS_CLOUD_TYPE&lt;br&gt;LAYERZERO_KMS_IDS&lt;br&gt;LAYERZERO_CDK_DEPLOY_REGION&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;strokeColor=#DAA520;fillColor=#FFF0B8;fontColor=#111111;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="280" width="250" height="190" as="geometry"/></mxCell>
        <mxCell id="helper" value="&lt;b&gt;Credential helper sidecar&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size: 11px;&quot;&gt;sidecars&lt;/font&gt;&lt;br&gt;&lt;br&gt;for example aws_signing_helper serve: trades a client certificate for temporary AWS credentials and serves them on localhost" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;dashed=1;strokeColor=#DAA520;fillColor=#FFF0B8;fontColor=#111111;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="750" y="280" width="250" height="190" as="geometry"/></mxCell>
        <mxCell id="cm" value="&lt;b&gt;ConfigMap&lt;/b&gt;&lt;br&gt;providers.json, quorum-strategy.json" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;strokeColor=#6C8EBF;fillColor=#FFFFFF;fontColor=#111111;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="550" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="cert" value="&lt;b&gt;Client certificate Secret&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size: 11px;&quot;&gt;extraVolumes, extraVolumeMounts&lt;/font&gt;&lt;br&gt;e.g. from a cert-manager Certificate in &lt;font face=&quot;monospace&quot; style=&quot;font-size: 11px;&quot;&gt;extraDeploy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;dashed=1;strokeColor=#159447;fillColor=#FFFFFF;fontColor=#111111;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="750" y="550" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="gone" value="&lt;b&gt;Not rendered with signer.type=KMS&lt;/b&gt;&lt;br&gt;mnemonic Secret (walletMnemonicMapping), wallets.json and their volume mounts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1;dashed=1;strokeColor=#9E9E9E;fillColor=#EEEEEE;fontColor=#616161;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="670" width="700" height="70" as="geometry"/></mxCell>

        <mxCell id="aws" value="AWS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;strokeWidth=3;dashed=1;dashPattern=4 4;strokeColor=#FF9900;fillColor=#FFF5E6;fontColor=#C76E00;fontStyle=1;fontSize=17;align=left;verticalAlign=top;spacingTop=6;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="1080" y="180" width="300" height="590" as="geometry"/></mxCell>
        <mxCell id="ra" value="&lt;b&gt;IAM Roles Anywhere&lt;/b&gt;&lt;br&gt;checks the client certificate against a trust anchor and returns temporary credentials" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;dashed=1;strokeColor=#FF9900;fillColor=#FFE0B2;fontColor=#111111;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="250" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="kms" value="&lt;b&gt;KMS key&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size: 11px;&quot;&gt;signer.kms.keyId&lt;br&gt;signer.kms.region&lt;/font&gt;&lt;br&gt;&lt;br&gt;signs the message hash, the private key can't be exported" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;strokeColor=#FF9900;fillColor=#FFE0B2;fontColor=#111111;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="430" width="260" height="140" as="geometry"/></mxCell>
        <mxCell id="gcp" value="cloudType: GCP works the same way with Google Cloud KMS. Credentials then come from the Google SDK chain." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="1100" y="680" width="260" height="70" as="geometry"/></mxCell>

        <mxCell id="values" value="&lt;b&gt;Chart values&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size: 11px;&quot;&gt;signer.type=KMS → SIGNER_TYPE&lt;br&gt;signer.kms.cloudType → KMS_CLOUD_TYPE (AWS or GCP)&lt;br&gt;signer.kms.keyId → LAYERZERO_KMS_IDS (one key per instance)&lt;br&gt;signer.kms.region → LAYERZERO_CDK_DEPLOY_REGION&lt;br&gt;extraEnv → credentials for the SDK chain&lt;br&gt;sidecars → credential helper container&lt;br&gt;extraVolumes, extraVolumeMounts → client certificate&lt;br&gt;extraDeploy → e.g. cert-manager Certificate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;strokeWidth=1;strokeColor=#DAA520;fillColor=#FFFFFF;fontColor=#111111;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="810" width="560" height="165" as="geometry"/></mxCell>
        <mxCell id="steps" value="&lt;b&gt;How a signature is made&lt;/b&gt;&lt;br&gt;① LayerZero asks Gasolina to sign a message.&lt;br&gt;② Gasolina checks the message with the RPC providers and goes on only when the quorum strategy is met.&lt;br&gt;③ Gasolina gets AWS credentials from the default AWS SDK chain. Here the sidecar serves them, set through &lt;font face=&quot;monospace&quot;&gt;extraEnv&lt;/font&gt; AWS_EC2_METADATA_SERVICE_ENDPOINT. Static keys from a Secret in &lt;font face=&quot;monospace&quot;&gt;extraEnv&lt;/font&gt; work as well.&lt;br&gt;④ Gasolina sends the message hash to KMS, which signs it and returns the signature.&lt;br&gt;⑤ Gasolina returns the signature. LayerZero submits it to the DVN contract on the destination chain." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;strokeWidth=1;strokeColor=#7B1FA2;fillColor=#FFFFFF;fontColor=#111111;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="810" width="780" height="165" as="geometry"/></mxCell>

        <mxCell id="e1" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#7B1FA2;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#4A148C;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="essence" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#7B1FA2;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="svc" target="gas"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="② check the message" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#EF6C00;endArrow=block;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#BF360C;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="gas" target="rpc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;dashed=1;strokeColor=#159447;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#0B5E2B;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.6458;entryDx=0;entryDy=0;" edge="1" parent="1" source="helper" target="ra"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3b" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;dashed=1;strokeColor=#159447;endArrow=block;endFill=1;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#0B5E2B;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="helper" target="gas"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="④ sign the hash" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#E53935;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#B71C1C;exitX=0.72;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gas" target="kms"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="500"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="⑤ submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#7B1FA2;endArrow=block;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#4A148C;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="essence" target="dvn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;dashed=1;strokeColor=#666666;endArrow=block;endFill=1;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cm" target="gas"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;dashed=1;strokeColor=#666666;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cert" target="helper"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
